<?xml version="1.0" encoding="utf-8"?><!--
    Nichts von dieser App wird gesichert oder auf ein anderes Geraet
    uebertragen. Das ist dieselbe Aussage wie android:allowBackup="false" im
    Manifest, nur fuer Android 12 und neuer - dort steuert diese Datei, was in
    ein Cloud-Backup und was in eine Geraeteuebertragung darf.

    **Beides ist noetig, keines genuegt allein:** allowBackup="false" gilt fuer
    Android 11 und aelter (die App laeuft ab API 26), diese Datei fuer 12 und
    neuer. Ohne sie meldet Lint ausserdem `DataExtractionRules`.

    **Der Grund steht im Info-Bildschirm**, und deshalb darf sich das hier nicht
    still aendern: Dort ist zugesagt, dass die Favoriten das Geraet nicht
    verlassen. Wer wieder ein Backup will, muss zuerst diesen Text anfassen -
    in allen vier Sprachen.

    `domain="root"` deckt das gesamte private Verzeichnis der App ab; die
    uebrigen Domaenen stehen daneben, weil sie nicht darin liegen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
