<!--
    Die Hintergrundebene ist einfarbig und traegt genau den Dunkelton, den auch
    das abgerundete Quadrat der Vorlage hat. Dadurch faellt nicht auf, dass die
    Vordergrundebene ihre eigene Form noch mitbringt - das System schneidet
    seine Maske aus der Flaeche, und die Kanten des Quadrats verschwinden im
    gleichfarbigen Hintergrund.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
