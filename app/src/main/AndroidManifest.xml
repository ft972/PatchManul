<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Netzwerkzugriff überhaupt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Für ConnectivityManager.getLinkProperties(): daraus liest der Scanner
         die eigene IPv4-Adresse und die Netzmaske, um das Subnetz zu bestimmen. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Ab Android 17 (API 37) ist der Zugriff auf das lokale Netz eine eigene
         Berechtigung. Ohne sie erreicht die App das Board im selben WLAN nicht.
         Auf älteren Geräten ist der Eintrag wirkungslos und wird ignoriert. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
        allowBackup="false" ist eine bewusste Entscheidung (20.08.2026, 1.7.0):
        Der Info-Bildschirm sagt zu, dass die Favoriten das Geraet nicht
        verlassen. Mit eingeschaltetem Backup waeren sie in der Datensicherung
        des Systems gelandet - die Zusage waere unwahr gewesen.

        Der Preis steht im Changelog: Bei Geraetewechsel oder Neuinstallation
        sind die Favoriten weg. Sie sind in einer Minute wieder angelegt, eine
        falsche Datenschutzangabe ist teurer.

        **Drei Angaben, nicht eine**, und alle drei sagen dasselbe - jede fuer
        ihren Geltungsbereich:

          allowBackup="false"    die Gesamtaussage
          fullBackupContent      bis Android 11
          dataExtractionRules    ab Android 12, wo allowBackup abgekuendigt ist

        Weil die App ab API 26 laeuft, faellt beides an; Lint besteht darauf
        (`DataExtractionRules`) und meldet sich, sobald eine der beiden Dateien
        fehlt. Ihr Inhalt ist jeweils ein vollstaendiger Ausschluss - anders als
        frueher, wo hier die leeren Vorlagen der Projektschablone standen.
    -->
    <application
        android:name=".PatchManulApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:ignore="UnusedAttribute"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PatchManul">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/info" />

        <!--
            Der Apache-2.0-Lizenztext, aufgerufen aus dem Info-Bildschirm.
            Eine eigene Activity aus demselben Grund wie dort: 178 Zeilen
            passen in keinen Dialog.
        -->
        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:label="@string/license_title" />

        <!--
            Eine eigene Activity statt eines Dialogs: Im Querformat waren die
            unteren Auswahlfelder sonst abgeschnitten.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings" />

        <!--
            Ohne diesen Eintrag merkt sich AppCompat die gewaehlte Sprache auf
            Geraeten unter Android 13 nicht - dort gibt es die Speicherung im
            System noch nicht. Ab Android 13 uebernimmt die Plattform, und der
            Dienst bleibt ungenutzt.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
